# Environment — apps/web
# Copy to .env.local and fill in real values. .env.local is gitignored.

# --- Database ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/screenly

# --- Auth (Better Auth) ---
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Google Play Developer API (Android in-app purchases) ---
# Service account for the Play Developer API. Create one in Google Cloud,
# then invite it in Play Console > Users and permissions with
# "View financial data" and "Manage orders and subscriptions".
# Grants purchase verification and refunds.
#
# PRIVATE KEY: paste the whole "-----BEGIN PRIVATE KEY-----" block on ONE line
# with real newlines written as \n. play.ts restores them before use.
GOOGLE_PLAY_PROJECT_ID=
GOOGLE_PLAY_CLIENT_EMAIL=
GOOGLE_PLAY_PRIVATE_KEY_ID=
GOOGLE_PLAY_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n

# Your app's Android applicationId, exactly as in the Play listing.
PLAY_ANDROID_PACKAGE=com.screenly.app

# --- Email ---
RESEND_API_KEY=
